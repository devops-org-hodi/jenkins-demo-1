pipeline{
    agent any
    environment{
        IMG_NAME = "app-1"
        IMG_TAG = "${BUILD_NUMBER}"
        CODE_DIR = "pipeline-1"
        IMAGE_FULL_NAME = "${IMG_NAME}:v0.${IMG_TAG}"
        CONTAINER_NAME = "app-1-container"
        TEST_PORT= "5050"
    }
    stages{
        stage("build docker image"){
            steps{
                sh 'ls -lah'
                echo '========= building docker image ========='
                sh "docker build -t ${IMAGE_FULL_NAME} ./${CODE_DIR}"
                echo "========= docker image built successfully  ${IMAGE_FULL_NAME}========="
                sh "docker images | grep -i ${IMG_NAME}"
            }
        }
        stage("run docker container"){
            steps{
                sh """ 
                    echo running docker container
                    docker run --name ${CONTAINER_NAME} -p ${TEST_PORT}:5000 -d ${IMAGE_FULL_NAME}
                    docker ps 
                """
            }
        }
        stage("test"){
            steps{
                sh " chmod +x ./${CODE_DIR}/test/unit-test.sh"
                sh "./${CODE_DIR}/test/unit-test.sh"
            }
        }
    }
    post{
        success{
            echo "========= build completed successfully ========="
        }
        failure{
            echo "========= build failed ========="
        }
        always{
            sh "docker rm -f ${CONTAINER_NAME}"
            sh "docker rmi -f ${IMAGE_FULL_NAME}"
        }
    }
}